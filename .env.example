# Bu faylı kopyalayıb `.env` adlandırın və öz dəyərlərinizi yazın.
# `.env` heç vaxt git-ə commit edilməməlidir (artıq .gitignore-dadır).

# --- Django əsasları ---
# Production-da (DJANGO_DEBUG=0) MÜTLƏQ unikal açar olmalıdır. Yaratmaq üçün:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# 1 = inkişaf rejimi (debug səhifələri, boş ALLOWED_HOSTS = "*" icazəsi)
# 0 = production (DJANGO_SECRET_KEY mütləq, ALLOWED_HOSTS mütləq doldurulmalıdır)
DJANGO_DEBUG=1

# Vergüllə ayrılmış domen siyahısı, məs: api.servio.az,www.servio.az
DJANGO_ALLOWED_HOSTS=

# Frontend-in işlədiyi domen(lər) — vergüllə ayrılmış, sxem daxil (https://...)
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Verilənlər bazası ---
# mssql = Microsoft SQL Server (production üçün tövsiyə olunur)
# sqlite = yalnız yerli sınaq üçün (server/driver quraşdırmadan tez test etmək istəyəndə)
DB_ENGINE=mssql

MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=servio
MSSQL_USER=sa
MSSQL_PASSWORD=
# Server-də quraşdırılmış ODBC drayverin dəqiq adı (aşağıdakı README qeydinə bax)
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
# Yerli/test SQL Server-ə (özünütəsdiqləyən sertifikatla) qoşularkən adətən belə qalır;
# etibarlı SSL sertifikatı olan production server-də TrustServerCertificate=no edin.
MSSQL_EXTRA_PARAMS=Encrypt=yes;TrustServerCertificate=yes;

# --- E-poçt (zəmanət sənədini müştəriyə göndərmək üçün) ---
# EMAIL_HOST boş qalsa, mesajlar yalnız konsola yazılır (real göndərmə olmur).
# Real göndərmə üçün öz SMTP hesabınızı (məs. info@sizinservis.az) doldurun.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=info@sizinservis.az
